# 依旧沉淀工作台环境变量样例
# 复制需要的变量到 .env 或当前 shell 中；不要把真实 API Key、cookie 或账号信息提交到代码仓库。

# 基础工作台：首次启动默认是空 Skill 库，所有运行产物位于此目录之外。
WORKBENCH_DATA_DIR=~/.local/share/douyin-script-workbench/public
# Raw video uploads are streamed to disk and rejected above this size.
WORKBENCH_MAX_VIDEO_UPLOAD_BYTES=536870912
# 默认 off。需要使用数据库持久化时，同时显式设置 WORKBENCH_ENABLE_PERSISTENCE=1。
WORKBENCH_DB_MODE=off
# WORKBENCH_ENABLE_PERSISTENCE=1
# 仅用于主动迁移旧版本机数据；默认绝不读取旧目录、旧数据库或历史诊断。
# WORKBENCH_ALLOW_LEGACY_DATA=1

# 主站媒体任务：网页用户不需要本机 Python、yt-dlp 或浏览器 Cookie。
# 视频和音频只在 WORKBENCH_DATA_DIR/media-tasks/temporary-media 中临时存在，任务结束即删除。
# 服务器需要安装 yt-dlp 与 ffmpeg；可填绝对路径以避免 systemd PATH 差异。
WORKBENCH_YTDLP_CMD=
WORKBENCH_FFMPEG_CMD=
WORKBENCH_MEDIA_DOWNLOAD_TIMEOUT=600
WORKBENCH_MEDIA_MAX_FILESIZE=350M
# 可选的合法网络出口；不填写时直接从主站公网出口下载。
WORKBENCH_MEDIA_PROXY=

# 必须是实际兼容 OpenAI POST /audio/transcriptions 的音频转写服务。
# 文本 LLM 中转站不能替代此服务。不要填入只提供 /chat/completions 的 API。
WORKBENCH_TRANSCRIPTION_API_BASE=
WORKBENCH_TRANSCRIPTION_MODEL=
WORKBENCH_TRANSCRIPTION_API_KEY=
WORKBENCH_TRANSCRIPTION_MAX_AUDIO_BYTES=52428800

# Skill runtime 发布（仅后端读取；不要在前端或仓库中写入 GitHub 凭据）
# 设为本机已 clone 的公开 Skill 仓库。发布只会写入 published/ 运行时文件。
DOUYIN_WRITING_SKILLS_REPO=
DOUYIN_WRITING_SKILLS_REMOTE=origin
DOUYIN_WRITING_SKILLS_BRANCH=main
DOUYIN_WRITING_SKILLS_REMOTE_URL=

# LLM 结构化输出
# offline: 只用本地 deterministic fallback
# optional: 优先调用模型，失败自动 fallback
# required: 模型失败则接口失败
WORKBENCH_LLM_MODE=offline
WORKBENCH_LLM_MODEL=openai/gpt-4.1-mini
WORKBENCH_LLM_API_BASE=
WORKBENCH_LLM_API_KEY=
# 涉及去世、被捕等重大事实时，需要 Codex CLI 浏览公开来源后再生成。
WORKBENCH_LLM_TRANSPORT=codex_cli
WORKBENCH_LLM_TEMPERATURE=0.2
WORKBENCH_LLM_MAX_RETRIES=1
# 单次 Codex 阶段至少保留 180 秒；完整任务预算由后端按两次调用自动计算。
WORKBENCH_LLM_TIMEOUT_SECONDS=60

# ASR: FunASR（仅用于本机开发或直接上传媒体的兼容流程；主站链接任务不会加载此模型。）
# auto: 有 FunASR 就尝试，没有就跳过
# off: 明确关闭
# required: 失败则返回 failed
WORKBENCH_ASR_MODE=auto
WORKBENCH_FUNASR_MODEL=paraformer-zh
WORKBENCH_FUNASR_VAD_MODEL=fsmn-vad
WORKBENCH_FUNASR_PUNC_MODEL=ct-punc
WORKBENCH_FUNASR_DEVICE=cpu

# OCR: PaddleOCR
WORKBENCH_OCR_MODE=auto
WORKBENCH_OCR_FRAME_COUNT=4
WORKBENCH_PADDLEOCR_ENGINE=paddle
WORKBENCH_PADDLEOCR_LANG=ch
# process: 让 ASR/OCR 在独立进程运行，原生模型异常不会带崩 API
# 建议指定一个单独安装 FunASR/PaddleOCR 的 Python；不要默认复用 macOS 系统 Python
WORKBENCH_MODEL_WORKER_PYTHON=.venv-model/bin/python
WORKBENCH_MODEL_WORKER_TIMEOUT=300
# 仅在你确认系统 Python 的 Paddle/FunASR 稳定时打开；默认关闭，避免 macOS 弹出 Python 崩溃框
WORKBENCH_ALLOW_SYSTEM_MODEL_PYTHON=false

# 抖音链接解析: jiji262/douyin-downloader
# 推荐：clone jiji262/douyin-downloader 后把目录填到这里
WORKBENCH_DOUYIN_DOWNLOADER_MODE=auto
WORKBENCH_DOUYIN_DOWNLOADER_DIR=
WORKBENCH_DOUYIN_DOWNLOADER_CMD=
WORKBENCH_DOUYIN_DOWNLOADER_PYTHON=
WORKBENCH_DOUYIN_DOWNLOADER_TIMEOUT=180
# yt-dlp 默认读取本机 Chrome Cookie；若需指定其他浏览器，可修改此值。
WORKBENCH_YTDLP_COOKIES_FROM_BROWSER=chrome
# 备用 douyin-downloader 可使用显式 Cookie（可留空，优先使用浏览器会话）。
WORKBENCH_DOUYIN_COOKIE_STRING=
