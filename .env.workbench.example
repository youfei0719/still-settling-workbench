# 依旧沉淀工作台环境变量样例。
# 复制需要的变量到 .env.workbench.local 或当前 shell；不要提交真实 API Key、Cookie 或账号信息。

# 首次启动默认是空 Skill 库，运行产物保存在项目目录之外。
WORKBENCH_DATA_DIR=~/.local/share/douyin-script-workbench/public
WORKBENCH_DB_MODE=off
# WORKBENCH_ENABLE_PERSISTENCE=1
# WORKBENCH_ALLOW_LEGACY_DATA=1

# Skill runtime 发布。不要在前端或仓库中写入 GitHub 凭据。
DOUYIN_WRITING_SKILLS_REPO=
DOUYIN_WRITING_SKILLS_REMOTE=origin
DOUYIN_WRITING_SKILLS_BRANCH=main
DOUYIN_WRITING_SKILLS_REMOTE_URL=

# LLM 结构化输出。
# offline: 只用本地 deterministic fallback
# optional: 优先调用模型，失败自动 fallback
# required: 模型失败则接口失败
WORKBENCH_LLM_MODE=offline
WORKBENCH_LLM_MODEL=openai/gpt-4.1-mini
WORKBENCH_LLM_API_BASE=
WORKBENCH_LLM_API_KEY=
WORKBENCH_LLM_TEMPERATURE=0.2
WORKBENCH_LLM_MAX_RETRIES=1
WORKBENCH_LLM_TIMEOUT_SECONDS=60

# ASR: FunASR。auto 表示可用时尝试，off 表示关闭，required 表示失败即停止。
WORKBENCH_ASR_MODE=auto
WORKBENCH_FUNASR_MODEL=paraformer-zh
WORKBENCH_FUNASR_VAD_MODEL=fsmn-vad
WORKBENCH_FUNASR_PUNC_MODEL=ct-punc
WORKBENCH_FUNASR_DEVICE=cpu

# OCR: PaddleOCR。
WORKBENCH_OCR_MODE=auto
WORKBENCH_OCR_FRAME_COUNT=4
WORKBENCH_PADDLEOCR_ENGINE=paddle
WORKBENCH_PADDLEOCR_LANG=ch
# 建议指定安装了 FunASR/PaddleOCR 的独立 Python。
WORKBENCH_MODEL_WORKER_PYTHON=.venv-model/bin/python
WORKBENCH_MODEL_WORKER_TIMEOUT=300
WORKBENCH_ALLOW_SYSTEM_MODEL_PYTHON=false

# 抖音链接解析。优先使用本机浏览器会话；显式 Cookie 可留空。
WORKBENCH_DOUYIN_DOWNLOADER_MODE=auto
WORKBENCH_DOUYIN_DOWNLOADER_DIR=
WORKBENCH_DOUYIN_DOWNLOADER_CMD=
WORKBENCH_DOUYIN_DOWNLOADER_PYTHON=
WORKBENCH_DOUYIN_DOWNLOADER_TIMEOUT=180
WORKBENCH_YTDLP_COOKIES_FROM_BROWSER=chrome
WORKBENCH_DOUYIN_COOKIE_STRING=
