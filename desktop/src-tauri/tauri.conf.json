{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "抖音写作 Skills",
  "version": "0.1.6",
  "identifier": "com.youfei.douyin-writing-skills",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173/?desktop=1",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "抖音写作 Skills",
      "width": 1440,
      "height": 920,
      "minWidth": 720,
      "minHeight": 620,
      "resizable": true,
      "fullscreen": false,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:8000 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {"minimumSystemVersion": "11.0", "hardenedRuntime": true},
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": {"language": "zh-CN"},
      "nsis": {"installMode": "perMachine"}
    }
  }
}
